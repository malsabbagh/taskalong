{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:taskalong:schema:v1:worker-result",
  "type": "object",
  "properties": {
    "kind": {
      "const": "worker_result"
    },
    "schema_version": {
      "const": "1.0"
    },
    "extensions": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]*:[A-Za-z0-9_.-]+$"
      }
    },
    "result_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "packet_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "packet_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "spec_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "completed",
        "blocked",
        "failed"
      ]
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "operation": {
            "enum": [
              "add",
              "modify"
            ]
          }
        },
        "required": [
          "path",
          "operation"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    },
    "command_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "claimed_exit_code": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "required": [
          "check_id",
          "claimed_exit_code"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 128
    },
    "summary": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 2048
      },
      "minItems": 0,
      "maxItems": 128
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 2048
      },
      "minItems": 0,
      "maxItems": 128
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 2048
      },
      "minItems": 0,
      "maxItems": 128
    },
    "qualification": {
      "enum": [
        "production",
        "synthetic"
      ]
    }
  },
  "required": [
    "kind",
    "schema_version",
    "extensions",
    "result_id",
    "packet_id",
    "packet_digest",
    "run_id",
    "attempt_id",
    "spec_digest",
    "status",
    "changed_files",
    "command_claims",
    "summary",
    "blockers",
    "deviations",
    "residual_risks",
    "qualification"
  ],
  "additionalProperties": false
}
