{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:taskalong:schema:v1:runtime-profile",
  "type": "object",
  "properties": {
    "kind": {
      "const": "runtime_profile"
    },
    "schema_version": {
      "const": "1.0"
    },
    "extensions": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]*:[A-Za-z0-9_.-]+$"
      }
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qualification": {
      "enum": [
        "production",
        "synthetic"
      ]
    },
    "adapter": {
      "const": "codex-cli"
    },
    "executable_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "executable_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "reasoning_effort": {
      "enum": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max",
        "ultra"
      ]
    },
    "service_tier": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "inference_destination_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "permission_policy": {
      "type": "object",
      "maxProperties": 128
    },
    "permission_policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "toolchain_read_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "credential_source_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "qualification_receipt_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    }
  },
  "required": [
    "kind",
    "schema_version",
    "extensions",
    "profile_id",
    "digest",
    "qualification",
    "adapter",
    "executable_path",
    "executable_sha256",
    "runtime_version",
    "model",
    "reasoning_effort",
    "service_tier",
    "inference_destination_id",
    "permission_policy",
    "permission_policy_digest",
    "toolchain_read_roots",
    "credential_source_ref",
    "qualification_receipt_ids"
  ],
  "additionalProperties": false
}
