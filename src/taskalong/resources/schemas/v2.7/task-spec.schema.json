{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:taskalong:schema:v2.7:task-spec",
  "type": "object",
  "properties": {
    "kind": {
      "const": "task_spec"
    },
    "schema_version": {
      "const": "2.7"
    },
    "extensions": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]*:[A-Za-z0-9_.-]+$"
      }
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 16384
      },
      "minItems": 0,
      "maxItems": 128
    },
    "repository": {
      "type": "object",
      "properties": {
        "registration_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "base_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "base_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "registration_id",
        "base_commit",
        "base_ref"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "operations": {
          "type": "array",
          "items": {
            "enum": [
              "add",
              "modify"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        }
      },
      "required": [
        "files",
        "operations"
      ],
      "additionalProperties": false
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "check_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "description",
          "check_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "minItems": 1,
            "maxItems": 128
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600
          },
          "expected_exit_code": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "criterion_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "argv",
          "cwd",
          "timeout_seconds",
          "expected_exit_code",
          "criterion_ids",
          "required"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128
    },
    "execution": {
      "type": "object",
      "properties": {
        "adapter": {
          "const": "codex-cli"
        },
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "profile_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "adapter",
        "profile_id",
        "profile_digest"
      ],
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "properties": {
        "local_edit": {
          "type": "boolean"
        },
        "local_commit": {
          "type": "boolean"
        },
        "inference_destination_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "allowed_effects": {
          "type": "array",
          "items": {
            "enum": [
              "execute",
              "verify",
              "commit_candidate",
              "push_branch",
              "create_draft_pr"
            ]
          },
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true
        }
      },
      "required": [
        "local_edit",
        "local_commit",
        "inference_destination_id",
        "allowed_effects"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "attempt_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "total_active_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 8388608
        },
        "hard_cost_usd": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "hard_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        }
      },
      "required": [
        "max_attempts",
        "attempt_seconds",
        "total_active_seconds",
        "max_output_bytes",
        "hard_cost_usd",
        "hard_tokens",
        "attempt_output_bytes"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "required": {
          "const": true
        },
        "integration": {
          "const": "reviewsensei"
        },
        "contract": {
          "const": "0.8.8/v1"
        },
        "config_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])",
          "minLength": 64,
          "maxLength": 64
        },
        "require_full_coverage": {
          "const": true
        }
      },
      "required": [
        "required",
        "integration",
        "contract",
        "config_digest",
        "require_full_coverage"
      ],
      "additionalProperties": false
    },
    "publication": {
      "type": "null"
    },
    "qualification": {
      "const": "synthetic"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])",
      "minLength": 64,
      "maxLength": 64
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "scope": {
            "type": "object",
            "properties": {
              "files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "minItems": 1,
                "maxItems": 256,
                "uniqueItems": true
              },
              "operations": {
                "type": "array",
                "items": {
                  "enum": [
                    "add",
                    "modify"
                  ]
                },
                "minItems": 1,
                "maxItems": 2,
                "uniqueItems": true
              }
            },
            "required": [
              "files",
              "operations"
            ],
            "additionalProperties": false
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}(?![\\s\\S])",
                  "minLength": 64,
                  "maxLength": 64
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 32
          },
          "required": {
            "const": true
          }
        },
        "required": [
          "step_id",
          "goal",
          "scope",
          "inputs",
          "required"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 8
    },
    "final_verification": {
      "type": "object",
      "properties": {
        "max_passes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "total_active_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 8388608
        }
      },
      "required": [
        "max_passes",
        "total_active_seconds",
        "max_output_bytes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "schema_version",
    "extensions",
    "task_id",
    "revision",
    "goal",
    "non_goals",
    "repository",
    "scope",
    "criteria",
    "checks",
    "execution",
    "permissions",
    "budget",
    "review",
    "publication",
    "qualification",
    "digest",
    "steps",
    "final_verification"
  ],
  "additionalProperties": false
}
