{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:taskalong:schema:v2:execution-binding",
  "title": "execution-binding",
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_.-]{0,63}(?![\\s\\S])"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "installation_digest",
    "provider_profile_digest",
    "instruction_bundle_digest",
    "tool_policy_digest",
    "worker_sandbox_digest",
    "check_binding_digest",
    "required_capabilities",
    "budget",
    "native_resume",
    "digest"
  ],
  "properties": {
    "kind": {
      "const": "execution_binding"
    },
    "schema_version": {
      "const": "2.0"
    },
    "installation_digest": {
      "$ref": "#/$defs/sha256"
    },
    "provider_profile_digest": {
      "$ref": "#/$defs/sha256"
    },
    "instruction_bundle_digest": {
      "$ref": "#/$defs/sha256"
    },
    "tool_policy_digest": {
      "$ref": "#/$defs/sha256"
    },
    "worker_sandbox_digest": {
      "$ref": "#/$defs/sha256"
    },
    "check_binding_digest": {
      "$ref": "#/$defs/sha256"
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "start",
          "observe",
          "local_cessation",
          "structured_result",
          "native_resume",
          "remote_cancellation",
          "hard_token_cap",
          "hard_cost_cap"
        ]
      },
      "maxItems": 8,
      "uniqueItems": true
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_seconds",
        "max_attempts",
        "max_cost_micro_usd",
        "max_tokens",
        "hard_cost_cap_required",
        "hard_token_cap_required"
      ],
      "properties": {
        "wall_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_cost_micro_usd": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "max_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "hard_cost_cap_required": {
          "type": "boolean"
        },
        "hard_token_cap_required": {
          "type": "boolean"
        }
      }
    },
    "native_resume": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol_version",
            "session_scope",
            "compatibility_digest"
          ],
          "properties": {
            "protocol_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?![\\s\\S])"
            },
            "session_scope": {
              "const": "exact_stored_session"
            },
            "compatibility_digest": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "digest": {
      "$ref": "#/$defs/sha256"
    }
  }
}
