{
  "type": "object",
  "properties": {
    "kind": {
      "const": "file_set_patch"
    },
    "schema_version": {
      "const": "2.10"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "operation": {
            "enum": [
              "add",
              "modify"
            ]
          },
          "before_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "before_bytes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 1048576
              },
              {
                "type": "null"
              }
            ]
          },
          "after_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "after_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          },
          "mode": {
            "enum": [
              "100644",
              "100755"
            ]
          },
          "payload_output_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          }
        },
        "required": [
          "path",
          "operation",
          "before_sha256",
          "before_bytes",
          "after_sha256",
          "after_bytes",
          "mode",
          "payload_output_id"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 256
    }
  },
  "required": [
    "kind",
    "schema_version",
    "digest",
    "files"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:taskalong:schema:v2.10:file-set-patch"
}
