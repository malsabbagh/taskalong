{
  "type": "object",
  "properties": {
    "kind": {
      "const": "packet_projection"
    },
    "schema_version": {
      "const": "2.10"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "run_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "spec_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "step_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "step_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "lease_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "binding_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configuration_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "admission_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "resolved_inputs_blob_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "import_journal_blob_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "predecessor_receipt_blob_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "canonical_packet_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "wire_packet_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "route_packet_blob_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "route_projection_blob_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "wire_version": {
      "enum": [
        "1.0",
        "2.3"
      ]
    }
  },
  "required": [
    "kind",
    "schema_version",
    "digest",
    "run_id",
    "spec_digest",
    "step_id",
    "step_index",
    "attempt_id",
    "lease_generation",
    "workspace_id",
    "binding_digest",
    "configuration_digest",
    "admission_digest",
    "resolved_inputs_blob_sha256",
    "import_journal_blob_sha256",
    "predecessor_receipt_blob_sha256",
    "canonical_packet_digest",
    "wire_packet_digest",
    "route_packet_blob_sha256",
    "route_projection_blob_sha256",
    "wire_version"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:taskalong:schema:v2.10:packet-projection"
}
