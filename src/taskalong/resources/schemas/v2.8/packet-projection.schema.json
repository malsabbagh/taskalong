{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:taskalong:schema:v2.8:packet-projection",
  "title": "E1 canonical packet and wire identity mapping; not an active transport",
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "run_id",
    "attempt_id",
    "spec_digest",
    "canonical_packet_digest",
    "wire_packet_digest",
    "binding_digest",
    "admission_digest",
    "activation_digest",
    "reviewer_profile_digest",
    "registration_digest",
    "driver_config_digest",
    "provider_profile_digest",
    "projection",
    "lease_generation",
    "session_policy",
    "input_framing",
    "digest"
  ],
  "properties": {
    "kind": {
      "const": "packet_projection"
    },
    "schema_version": {
      "const": "2.8"
    },
    "run_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "spec_digest": {
      "$ref": "#/$defs/sha256"
    },
    "canonical_packet_digest": {
      "$ref": "#/$defs/sha256"
    },
    "wire_packet_digest": {
      "$ref": "#/$defs/sha256"
    },
    "binding_digest": {
      "$ref": "#/$defs/sha256"
    },
    "admission_digest": {
      "$ref": "#/$defs/sha256"
    },
    "activation_digest": {
      "$ref": "#/$defs/sha256"
    },
    "reviewer_profile_digest": {
      "$ref": "#/$defs/sha256"
    },
    "registration_digest": {
      "$ref": "#/$defs/sha256"
    },
    "driver_config_digest": {
      "$ref": "#/$defs/sha256"
    },
    "provider_profile_digest": {
      "$ref": "#/$defs/sha256"
    },
    "projection": {
      "const": "codex-real-start/1"
    },
    "lease_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "session_policy": {
      "const": "fresh"
    },
    "input_framing": {
      "const": "canonical-packet-json/1"
    },
    "digest": {
      "$ref": "#/$defs/sha256"
    }
  }
}
